<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>在 WorkFollow 中显示系统日历里的会议和日程。</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>将你选择的任务和提醒时间同步到 Apple 提醒事项，并读取完成状态及修改。选择 iCloud 清单后，可在 iPhone 的提醒事项中查看和接收提醒。</string>
    <key>NSRemindersUsageDescription</key>
    <string>将你选择的任务与 Apple 提醒事项同步。</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>采集本地会议声音用于转写，音频仅在内存中处理、不保存录音文件；通过 Pi 发送至配置的模型服务。</string>
    <key>WorkFollowAcceptanceStorageRoot</key>
    <string>$(WF_ACCEPTANCE_STORAGE_ROOT)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.workfollow.native.resource</string>
            <key>CFBundleURLSchemes</key>
            <array><string>workfollow</string></array>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
        </dict>
    </array>
</dict>
</plist>
