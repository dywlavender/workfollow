WORKFOLLOW_DATABASE_URL=sqlite:///../data/workfollow.db
WORKFOLLOW_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:5174"]
# 外部任务通知接口；留空则不启用外部通知发送器
WORKFOLLOW_NOTIFICATION_HTTP_URL=
# 浏览器打开 WorkFollow 链接使用的服务器地址；开发环境通常为 http://127.0.0.1:5173
WORKFOLLOW_SERVER_URL=
WORKFOLLOW_NOTIFICATION_HTTP_TIMEOUT_SECONDS=5
WORKFOLLOW_NOTIFICATION_HTTP_RETRY_COUNT=3
WORKFOLLOW_NOTIFICATION_TASK_EDIT_QUIET_SECONDS=3
WORKFOLLOW_NOTIFICATION_TIMEZONE=Asia/Shanghai
WORKFOLLOW_NOTIFICATION_DAILY_DIGEST_TIME=08:30
# FastAPI and the Yjs collaboration service share this value. Configure it
# once in the project-root .env; collaboration/server.mjs loads it automatically.
WORKFOLLOW_COLLABORATION_INTERNAL_TOKEN=
WORKFOLLOW_COLLABORATION_PORT=8124
WORKFOLLOW_COLLABORATION_BIND=127.0.0.1
# FastAPI 调用协同服务内部 Agent 文档接口的地址。
WORKFOLLOW_COLLABORATION_HTTP_URL=http://127.0.0.1:8124

# 以下配置用于 Web 后端；原生 App 在设置中维护直接调用模型，语音转写仍使用 Pi。
WORKFOLLOW_AI_ENABLED=false
WORKFOLLOW_AI_BASE_URL=https://api.openai.com/v1
WORKFOLLOW_AI_API_KEY=
WORKFOLLOW_AI_MODEL=
WORKFOLLOW_AI_PROTOCOL=openai_chat
WORKFOLLOW_AI_ANTHROPIC_WORKSPACE_ID=
# 按所选模型实际能力配置；兼容服务的模型列表未必提供上下文窗口信息。
WORKFOLLOW_AI_CONTEXT_WINDOW=32768
WORKFOLLOW_AI_MAX_OUTPUT_TOKENS=2048
WORKFOLLOW_AI_CONTEXT_MARGIN=1024
WORKFOLLOW_AI_TIMEOUT_SECONDS=90
WORKFOLLOW_AI_MAX_CHUNKS=32
WORKFOLLOW_AI_SUMMARY_TRIGGER_RATIO=0.7
WORKFOLLOW_AI_SUMMARY_KEEP_RATIO=0.2
